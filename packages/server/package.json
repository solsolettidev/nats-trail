{
  "name": "@nats-trail/server",
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -b",
    "prepack": "node ../../scripts/prepare-packages.mjs"
  },
  "dependencies": {
    "@nats-trail/core": "0.5.0",
    "@nats-trail/mcp": "0.5.0",
    "express": "^4.21.1",
    "nats": "^2.29.2",
    "ws": "^8.18.0",
    "@nats-trail/ui": "0.5.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "license": "Apache-2.0",
  "author": "Sol Soletti",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solsolettidev/nats-trail.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/solsolettidev/nats-trail#readme",
  "bugs": {
    "url": "https://github.com/solsolettidev/nats-trail/issues"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "natstrail-server": "./dist/main.js"
  },
  "engines": {
    "node": ">=22"
  }
}
